{
  "appId": "com.kinesioguard.neuro",
  "appName": "KinesioGuard",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#05070F"
  },
  "plugins": {
    "InertialKinematics": {
      "sampleRateHz": 200,
      "sensorDelay": "SENSOR_DELAY_FASTEST",
      "highPassGravityCutoffHz": 1.0
    },
    "BioHapticStabilizer": {
      "phaseOffsetDegrees": 180,
      "maxAmplitude": 255,
      "postureAlertChimeEnabled": true
    }
  }
}
